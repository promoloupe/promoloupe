{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make fmt)",
      "Bash(make vet)",
      "Bash(make manifests)",
      "Bash(make generate)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go mod tidy)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(pre-commit run *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(make test-e2e)",
      "Bash(make install)",
      "Bash(make deploy *)",
      "Bash(make undeploy *)",
      "Bash(kubectl *)",
      "Bash(kind *)",
      "Bash(helm *)",
      "Bash(go get *)",
      "Bash(uv add *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.kubeconfig)",
      "Read(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(/**/zz_generated.*.go)",
      "Edit(/config/crd/bases/**)",
      "Edit(/config/rbac/role.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.sh",
            "args": [],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
